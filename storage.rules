rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function roomPath(roomId) {
      return /databases/(default)/documents/rooms/$(roomId);
    }

    function roomExists(roomId) {
      return firestore.exists(roomPath(roomId));
    }

    function room(roomId) {
      return firestore.get(roomPath(roomId)).data;
    }

    function isRoomMember(roomId) {
      return request.auth != null
        && roomExists(roomId)
        && (
          (room(roomId).members is list && request.auth.uid in room(roomId).members)
          || (!('members' in room(roomId)) && room(roomId).ownerId == request.auth.uid)
        )
        && room(roomId).expiresAt > request.time;
    }

    match /rooms/{roomId}/{fileName=**} {
      allow read: if isRoomMember(roomId);

      allow create, update: if isRoomMember(roomId)
        && request.resource != null
        && request.resource.size <= 50 * 1024 * 1024;

      allow delete: if request.auth != null
        && roomExists(roomId)
        && room(roomId).ownerId == request.auth.uid;
    }
  }
}
