rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function roomExists(roomId) {
      return exists(roomPath(roomId));
    }

    function room(roomId) {
      return get(roomPath(roomId)).data;
    }

    function isRoomMember(roomId) {
      return signedIn()
        && roomExists(roomId)
        && (
          (room(roomId).members is list && request.auth.uid in room(roomId).members)
          || (!('members' in room(roomId)) && room(roomId).ownerId == request.auth.uid)
        );
    }

    function isRoomOwner(roomId) {
      return signedIn()
        && roomExists(roomId)
        && room(roomId).ownerId == request.auth.uid;
    }

    function roomIsActive(roomId) {
      return isRoomMember(roomId)
        && room(roomId).expiresAt > request.time;
    }

    match /rooms/{roomId} {
      // Joining requires a known six-digit code. Listing rooms is never allowed.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'roomId', 'createdAt', 'expiresAt', 'activeUsers', 'members',
          'status', 'lifetimeMinutes', 'ownerId'
        ])
        && request.resource.data.roomId == roomId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(125, 'm')
        && request.resource.data.lifetimeMinutes in [10, 30, 60, 120]
        && request.resource.data.activeUsers == 1
        && request.resource.data.status == 'active'
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0] == request.auth.uid;

      allow update: if signedIn()
        && resource.data.status == 'active'
        && resource.data.expiresAt > request.time
        && request.resource.data.status == resource.data.status
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'activeUsers'])
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 2
        && request.resource.data.activeUsers == request.resource.data.members.size()
        && (
          // A joining user may add only their own UID to a room with one member.
          (
            !(request.auth.uid in resource.data.members)
            && request.auth.uid in request.resource.data.members
            && resource.data.members.size() == 1
            && request.resource.data.members.size() == 2
            && request.resource.data.members.hasAll(resource.data.members)
          )
          ||
          // Migrate a legacy room once when its invited second device joins.
          (
            !('members' in resource.data)
            && resource.data.ownerId is string
            && request.auth.uid != resource.data.ownerId
            && resource.data.devices is list
            && resource.data.devices.size() == 1
            && request.auth.uid in request.resource.data.members
            && resource.data.ownerId in request.resource.data.members
            && request.resource.data.members.size() == 2
            && request.resource.data.members.hasAll([resource.data.ownerId, request.auth.uid])
          )
          ||
          // A member may remove only themselves when leaving.
          (
            request.auth.uid in resource.data.members
            && !(request.auth.uid in request.resource.data.members)
            && resource.data.members.size() == request.resource.data.members.size() + 1
            && resource.data.members.hasAll(request.resource.data.members)
          )
        );

      allow delete: if isRoomOwner(roomId);
    }

    match /rooms/{roomId}/{document=**} {
      allow read: if roomIsActive(roomId);
      allow create, update: if roomIsActive(roomId);
      allow delete: if isRoomOwner(roomId);
    }
  }
}
